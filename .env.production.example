DJANGO_ENV=production

# Generate a completely separate production key.
DJANGO_SECRET_KEY=replace-with-a-long-random-production-key

# No wildcard "*"
DJANGO_ALLOWED_HOSTS=cyberlab.example.com

# Must include scheme.
DJANGO_CSRF_TRUSTED_ORIGINS=https://cyberlab.example.com

# PostgreSQL
DJANGO_DB_NAME=cyberlab
DJANGO_DB_USER=cyberlab
DJANGO_DB_PASSWORD=replace-me
DJANGO_DB_HOST=postgres
DJANGO_DB_PORT=5432

# Enable only if a trusted reverse proxy is responsible for HTTPS
# and strips/replaces incoming X-Forwarded-Proto headers.
DJANGO_TRUST_PROXY_HEADERS=false

# Start conservatively. Increase once HTTPS is proven stable.
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false

# Optional old keys while rotating SECRET_KEY.
DJANGO_SECRET_KEY_FALLBACKS=
