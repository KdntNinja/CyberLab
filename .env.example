DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-generated-development-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Normally empty in development
DJANGO_CSRF_TRUSTED_ORIGINS=

# Only enable when behind a trusted reverse proxy that correctly
# strips and sets X-Forwarded-Proto.
DJANGO_TRUST_PROXY_HEADERS=false
